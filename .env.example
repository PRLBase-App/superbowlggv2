# ── Superbowl.gg environment template ─────────────────────────────
# Copy to .env and fill in. NEVER commit .env.

# Core
NODE_ENV=development
DATABASE_URL=postgresql://sbgg:sbgg-dev@localhost:5432/superbowlgg
# Optional. The first Railway release schedules jobs through PostgreSQL.
REDIS_URL=
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Superbowl

# Auth
AUTH_SECRET=replace-with-32+-char-random
AUTH_BETTER_SECRET=replace-with-32+-char-random
EMAIL_FROM=Superbowl <noreply@superbowl.gg>
RESEND_API_KEY=

# Sports data — free key: https://dashboard.api-football.com/
# Missing credentials never fall back to generated data.
API_SPORTS_KEY=
API_SPORTS_BASE_URL=https://v1.american-football.api-sports.io
API_SPORTS_SEASON=

# Odds — free key: https://the-odds-api.com/
THE_ODDS_API_KEY=
THE_ODDS_API_BASE_URL=https://api.the-odds-api.com/v4

# SEMrush (MCP access token; server-side only, never in NEXT_PUBLIC_*)
SEMRUSH_API_KEY=
SEMRUSH_MCP_URL=https://mcp.semrush.com/v2/mcp
SEMRUSH_DATABASE=us
SEMRUSH_COUNTRY=US
SEMRUSH_RESEARCH_ENABLED=true
SEMRUSH_MAX_UNITS_PER_RUN=100
SEMRUSH_CACHE_DAYS=30

# Admin bootstrap
ADMIN_EMAIL=admin@superbowl.gg

# Object storage (optional)
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Geo / AI (optional)
GEOIP_PROVIDER=none
GEOIP_API_KEY=
AI_PROVIDER=none
AI_API_KEY=
